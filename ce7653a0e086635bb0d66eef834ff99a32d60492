        "id": 1010111
      },
      "writtenOn": "2019-03-04T14:08:44Z",
      "side": 1,
      "message": "Seems kind of inefficient to always allocate this only to throw it away in the most common case.",
      "revId": "ce7653a0e086635bb0d66eef834ff99a32d60492",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
