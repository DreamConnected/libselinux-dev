      "side": 1,
      "message": "@zhidou@google.com This is to avoid the implicit dependency on `server_configurable_flags` but  I couldn\u0027t find any other example using this mode in AOSP. Could you confirm if this is the recommended approach? Thanks.",
      "range": {
        "startLine": 10,
        "startChar": 1,
        "endLine": 10,
        "endChar": 16
      },
      "revId": "b76d6ccda33c37cb0ae0c778cc43b5146e1571c0",
