package: "com.android.libselinux.flags"
container: "system"

flag {
    namespace: "platform_security"
    name: "data_data_ignore"
    description: "Bugfix to skip the labelling of /data/data by default."
    bug: "317296680"
    is_fixed_read_only: true
}
